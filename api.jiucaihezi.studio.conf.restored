server {
    server_name api.jiucaihezi.studio;
    client_max_body_size 200m;

    # === 安全加固 2026-05-10 ===
    proxy_hide_header X-New-Api-Version;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 封掉未使用的支付回调端点
    location = /favicon.ico {
        alias /opt/new-api/static/logo.svg;
        default_type image/svg+xml;
        expires 30d;
    }

    location /site-assets/ {
        alias /opt/new-api/static/;
    }

    location = /checkout/alipay {
        alias /opt/new-api/checkout/alipay.html;
        default_type text/html;
    }
    location = /payment-preview {
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
    }

    location = /api/stripe/webhook { return 403; }
    location = /api/creem/webhook { return 403; }
    location = /api/waffo/webhook { return 403; }

    location /xunhu/ {
        rewrite ^/xunhu/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /logo.png {
        alias /opt/new-api/static/logo.svg;
        default_type image/svg+xml;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        # 品牌替换
        proxy_set_header Accept-Encoding "";
        sub_filter_types text/html;
        sub_filter_once off;
        sub_filter '<title>New API</title>' '<title>韭菜盒子</title>';
        sub_filter 'content="New API"' 'content="韭菜盒子"';
        sub_filter 'content="Unified AI API gateway and admin dashboard."' 'content="韭菜盒子 · AI 模型聚合平台"';
        sub_filter '</head>' '<meta property="og:title" content="韭菜盒子"/><meta property="og:description" content="韭菜盒子 AI 模型聚合平台"/><meta property="og:type" content="website"/><meta property="og:image" content="https://api.jiucaihezi.studio/site-assets/logo.svg"/></head>';
    }

    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/api.jiucaihezi.studio/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.jiucaihezi.studio/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = api.jiucaihezi.studio) {
        return 301 https://$host$request_uri;
    }
    listen 80;
    listen [::]:80;
    server_name api.jiucaihezi.studio;
    return 404;
}
