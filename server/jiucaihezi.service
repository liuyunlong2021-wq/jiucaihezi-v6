[Unit]
Description=韭菜盒子 Office & Graphify API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/jiucaihezi
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8090 --workers 2
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/jiucaihezi

[Install]
WantedBy=multi-user.target
